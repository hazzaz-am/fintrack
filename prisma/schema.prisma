generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT_CONTRIBUTION
  INVESTMENT_RETURN
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
}

enum SavingsGoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

enum GoalReservationPromiseStatus {
  OPEN
  PARTIALLY_RESOLVED
  RESOLVED
  WRITTEN_OFF
}

enum InvestmentStatus {
  PLANNED
  ACTIVE
  MATURED
  WITHDRAWN
  CANCELLED
}

enum LoanStatus {
  OPEN
  PARTIALLY_REPAID
  REPAID
  WRITTEN_OFF
}

enum RecurringTransactionType {
  INCOME
  EXPENSE
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringTransactionStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  defaultCurrency String   @default("BDT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts                Account[]
  categories              Category[]
  transactions            Transaction[]
  savingsGoals            SavingsGoal[]
  investments             Investment[]
  recurringTransactions   RecurringTransaction[]
  goalReservationPromises GoalReservationPromise[]
  borrowers               Borrower[]
  loans                   Loan[]

  @@map("users")
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  name           String
  institution    String?
  type           String
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  currency       String        @default("BDT")
  description    String?
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionsAsAccount Transaction[]            @relation("TransactionAccount")
  transactionsAsSource  Transaction[]            @relation("TransactionSourceAccount")
  transactionsAsDest    Transaction[]            @relation("TransactionDestinationAccount")
  goalAllocationEvents  GoalAllocationEvent[]
  reservationPromises   GoalReservationPromise[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id               String       @id @default(cuid())
  userId           String
  name             String
  type             CategoryType
  parentCategoryId String?
  icon             String?
  createdAt        DateTime     @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentCategory        Category?              @relation("CategoryParent", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories       Category[]             @relation("CategoryParent")
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

// Structural integrity beyond what Prisma can express is enforced by a
// CHECK constraint added via migration (see migration.sql):
//   - INCOME/EXPENSE rows require accountId + categoryId, and no source/destination/investment.
//   - TRANSFER rows require sourceAccountId + destinationAccountId (and they differ),
//     and no accountId/categoryId/investmentId.
//   - INVESTMENT_CONTRIBUTION/INVESTMENT_RETURN rows require accountId + investmentId,
//     and no categoryId/source/destination (design.md D6).
model Transaction {
  id                     String          @id @default(cuid())
  userId                 String
  accountId              String?
  categoryId             String?
  sourceAccountId        String?
  destinationAccountId   String?
  investmentId           String?
  loanId                 String?
  recurringTransactionId String?
  type                   TransactionType
  amount                 Decimal         @db.Decimal(14, 2)
  vatAmount              Decimal?        @db.Decimal(14, 2)
  description            String?
  transactionDate        DateTime
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account?              @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceAccount        Account?              @relation("TransactionSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  destinationAccount   Account?              @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Cascade)
  investment           Investment?           @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  loan                 Loan?                 @relation(fields: [loanId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  reservationEvents    GoalAllocationEvent[] @relation("TransactionReservationEvents")

  @@index([userId])
  @@index([accountId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([investmentId])
  @@index([loanId])
  @@index([recurringTransactionId])
  @@index([userId, transactionDate])
  @@map("transactions")
}

model SavingsGoal {
  id           String            @id @default(cuid())
  userId       String
  name         String
  targetAmount Decimal           @db.Decimal(14, 2)
  targetDate   DateTime?
  status       SavingsGoalStatus @default(ACTIVE)
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocationEvents    GoalAllocationEvent[]
  reservationPromises GoalReservationPromise[]

  @@index([userId])
  @@map("savings_goals")
}

// `sourceTransactionId` traces an event created by the reserved-funds guard
// (goal-reservation-guard capability) back to the outflow transaction that
// caused it — null for events from the ordinary allocate/moveAllocation
// flows. `promiseId` links both the original negative event and any later
// positive return events to the GoalReservationPromise they belong to; also
// null for ordinary allocate/moveAllocation events. Both stay SetNull on
// delete of their target so this remains an append-only ledger — deleting
// the source transaction never deletes history, it only orphans the link
// (the reversing event is what actually undoes the effect).
model GoalAllocationEvent {
  id                  String   @id @default(cuid())
  savingsGoalId       String
  accountId           String
  amount              Decimal  @db.Decimal(14, 2)
  note                String?
  sourceTransactionId String?
  promiseId           String?
  createdAt           DateTime @default(now())

  savingsGoal       SavingsGoal             @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  account           Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceTransaction Transaction?            @relation("TransactionReservationEvents", fields: [sourceTransactionId], references: [id], onDelete: SetNull)
  promise           GoalReservationPromise? @relation(fields: [promiseId], references: [id], onDelete: SetNull)

  @@index([savingsGoalId])
  @@index([accountId])
  @@index([sourceTransactionId])
  @@index([promiseId])
  @@map("goal_allocation_events")
}

// Tracks a "return by date" commitment made when the reserved-funds guard
// (goal-reservation-guard capability) let a user consent to dipping into a
// goal's reserve. `remainingAmount` starts at `amount` and is paid down by
// partial/full returns (each a positive GoalAllocationEvent linked via
// promiseId); `status` is the only stored state — OVERDUE is deliberately
// not a stored value, it's derived at read time from `dueDate` vs. now,
// mirroring SavingsGoal's derived achieved-state convention.
model GoalReservationPromise {
  id              String                       @id @default(cuid())
  userId          String
  savingsGoalId   String
  accountId       String
  amount          Decimal                      @db.Decimal(14, 2)
  remainingAmount Decimal                      @db.Decimal(14, 2)
  dueDate         DateTime
  status          GoalReservationPromiseStatus @default(OPEN)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsGoal      SavingsGoal           @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  account          Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  allocationEvents GoalAllocationEvent[]

  @@index([userId])
  @@index([savingsGoalId])
  @@index([accountId])
  @@map("goal_reservation_promises")
}

// No accountId and no stored principal column (design.md D9, D7): funding
// accounts live on the INVESTMENT_CONTRIBUTION/INVESTMENT_RETURN Transaction
// rows instead, so one investment can be funded from multiple accounts over
// time, or from none at all (openingPrincipal covers pre-existing assets
// recorded without ledger history, mirroring Account.openingBalance).
model Investment {
  id                   String           @id @default(cuid())
  userId               String
  name                 String
  type                 String
  institution          String?
  openingPrincipal     Decimal          @default(0) @db.Decimal(14, 2)
  startDate            DateTime
  maturityDate         DateTime?
  expectedReturnAmount Decimal?         @db.Decimal(14, 2)
  expectedReturnRate   Decimal?         @db.Decimal(6, 3)
  currentValue         Decimal?         @db.Decimal(14, 2)
  status               InvestmentStatus @default(PLANNED)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("investments")
}

model Borrower {
  id        String   @id @default(cuid())
  userId    String
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@index([userId])
  @@map("borrowers")
}

// No `amount` or `sourceAccountId` column (design.md D1 revision): both are
// read off the single LOAN_DISBURSEMENT Transaction this loan is linked to
// via Transaction.loanId, exactly the way Investment stores no funding
// account and derives principal from its linked Transaction rows — a Loan
// simply has exactly one disbursement instead of Investment's many. Repaid
// amount/outstanding are likewise derived by summing LOAN_REPAYMENT
// transactions linked the same way, never stored.
model Loan {
  id         String     @id @default(cuid())
  userId     String
  borrowerId String
  dueDate    DateTime
  status     LoanStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  borrower     Borrower      @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([borrowerId])
  @@map("loans")
}

// No stored nextOccurrence (design.md D23): "due" is computed from
// startDate + frequency relative to today, checked against whether a
// Transaction already links to this template for the current slot. Editing
// a template only changes future slot computation — it never rewrites a
// Transaction already generated from it (design.md D27).
model RecurringTransaction {
  id          String                     @id @default(cuid())
  userId      String
  name        String
  accountId   String
  categoryId  String
  type        RecurringTransactionType
  amount      Decimal                    @db.Decimal(14, 2)
  frequency   RecurringFrequency
  startDate   DateTime
  endDate     DateTime?
  status      RecurringTransactionStatus @default(ACTIVE)
  description String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@map("recurring_transactions")
}
